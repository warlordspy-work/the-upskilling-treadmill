# Application Settings
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL Cloud SQL or local SQLite)
# For local development:
DATABASE_URL=sqlite:///./devsync.db
# For GCP Cloud SQL PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@/devsync_db?host=/cloudsql/project:region:instance

# Make.com Workflow Automation Webhook URL (for WhatsApp Nudge Triggers)
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-scenario-webhook-id

# WhatsApp Business API (WATI)
WATI_API_ENDPOINT=https://live-server-wati.wati.io/api/v1
WATI_ACCESS_TOKEN=your_wati_bearer_token

# Razorpay Subscription Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# AI Tutor Copilot
AI_TUTOR_API_KEY=your_openai_or_gemini_api_key
